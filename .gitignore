__pycache__/
*.pyc
*.pyo

# run outputs, at the repository root only -- NOT configs/experiments/, which holds the
# recipes (an unanchored "experiments/" matches at every level and excluded all of them)
/experiments/
/results/
/predictions/
*.pt
# ...except the landmark graphs shipped with the templates
!vox2seglam/templates/**/*.pt

# local data (symlinks to the non-redistributable datasets, see README "Weights and data")
/data
/data_afids

# editing backups (file.before_change.py), never part of a release
.*before_*
*.before_*
*.bak

# build and tooling artefacts
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.DS_Store
.claude/
